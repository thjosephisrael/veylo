# Veylo Environment Configuration Template
# In demo mode without credentials, Veylo runs in isolated demo mode with verified server-side persistence.
# For live testnet signing and execution, provide your Interledger Test Wallet credentials below.

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Open Payments Testnet Configuration (Server-Only — Never expose via NEXT_PUBLIC_)
# 1. Your Interledger Test Wallet address (e.g. https://ilp.interledger-test.dev/yourname)
OPEN_PAYMENTS_WALLET_ADDRESS=

# 2. Key ID issued when registering your public key in your Interledger Test Wallet account
OPEN_PAYMENTS_KEY_ID=

# 3. Path to your Ed25519 private key PEM file (e.g. ./private.key) OR the raw PEM string
OPEN_PAYMENTS_PRIVATE_KEY_PATH=
# OPEN_PAYMENTS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional: Recipient wallet address for live testnet merchant/p2p execution
# OPEN_PAYMENTS_RECIPIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/recipient

# Optional: Supabase Integration (when connecting managed cloud Postgres)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
